{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable hiking activity Stage 1",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "revision",
    "stage",
    "status",
    "title",
    "destination",
    "goals",
    "constraints",
    "weather",
    "candidates",
    "evidence",
    "changes",
    "trip_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "const": "goal_definition"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed",
        "needs_review"
      ]
    },
    "title": {
      "type": "string"
    },
    "destination": {
      "type": "object",
      "required": [
        "state",
        "name"
      ],
      "properties": {
        "state": {
          "enum": [
            "fixed",
            "preferred",
            "undecided"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "goals": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": [
        "date",
        "date_range",
        "departure_area",
        "difficulty",
        "estimated_participants",
        "latest_return",
        "hard_rules"
      ],
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "departure_area": {
          "type": [
            "string",
            "null"
          ]
        },
        "difficulty": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimated_participants": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "latest_return": {
          "type": [
            "string",
            "null"
          ]
        },
        "hard_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "weather": {
      "type": "object",
      "required": [
        "status",
        "snapshots",
        "assessment"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "unavailable",
            "current",
            "stale"
          ]
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "checked_at",
              "sources",
              "values",
              "assessment"
            ],
            "properties": {
              "checked_at": {
                "type": "string"
              },
              "valid_for": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "values": {
                "type": "object"
              },
              "assessment": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "assessment": {
          "type": "object",
          "required": [
            "level",
            "recommendation"
          ],
          "properties": {
            "level": {
              "enum": [
                "unknown",
                "suitable",
                "caution",
                "unsuitable"
              ]
            },
            "recommendation": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "url",
          "publisher",
          "checked_at",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "checked_at": {
            "type": "string"
          },
          "valid_for": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "pending",
              "stale"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "at",
          "field",
          "before",
          "after",
          "reason"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "route": {
      "type": "object",
      "required": [
        "status",
        "sections"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "reviewed",
            "confirmed"
          ]
        },
        "type": {
          "type": "string"
        },
        "duration_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "stops"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "stops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "offset_minutes": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "source_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "key_point": {
                      "type": "boolean"
                    },
                    "node_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "transport": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "inbound": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "scheduled_transit",
                  "driving",
                  "walking",
                  "flexible"
                ]
              },
              "schedule_status": {
                "enum": [
                  "pending",
                  "verified",
                  "not_applicable"
                ]
              },
              "timetable": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "service_date",
                      "departure_time",
                      "arrival_time",
                      "source_id",
                      "checked_at"
                    ],
                    "properties": {
                      "service_date": {
                        "type": "string",
                        "format": "date"
                      },
                      "departure_time": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "arrival_time": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "source_id": {
                        "type": "string"
                      },
                      "checked_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "service_id": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "estimated_duration_minutes": {
                "type": "integer",
                "minimum": 0
              },
              "departure_time": {
                "type": "string"
              },
              "preview_phase": {
                "enum": [
                  "before",
                  "hike",
                  "after"
                ],
                "description": "Legacy hike connector is already represented by route offsets and is excluded from transit simulation."
              },
              "reference_time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Requested boarding time around which nearby sourced services are selected."
              },
              "timetable_options": {
                "type": "array",
                "description": "Actual services queried by the Skill for the exact trip date, including up to two departures before and after the reference time. Never generated by the page.",
                "items": {
                  "type": "object",
                  "required": [
                    "service_date",
                    "departure_time",
                    "arrival_time",
                    "source_id",
                    "checked_at",
                    "service_id"
                  ],
                  "properties": {
                    "service_date": {
                      "type": "string",
                      "format": "date"
                    },
                    "departure_time": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "arrival_time": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "source_id": {
                      "type": "string"
                    },
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "service_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "outbound": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "scheduled_transit",
                  "driving",
                  "walking",
                  "flexible"
                ]
              },
              "schedule_status": {
                "enum": [
                  "pending",
                  "verified",
                  "not_applicable"
                ]
              },
              "timetable": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "service_date",
                      "departure_time",
                      "arrival_time",
                      "source_id",
                      "checked_at"
                    ],
                    "properties": {
                      "service_date": {
                        "type": "string",
                        "format": "date"
                      },
                      "departure_time": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "arrival_time": {
                        "type": "string",
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      "source_id": {
                        "type": "string"
                      },
                      "checked_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "service_id": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "estimated_duration_minutes": {
                "type": "integer",
                "minimum": 0
              },
              "departure_time": {
                "type": "string"
              },
              "preview_phase": {
                "enum": [
                  "before",
                  "hike",
                  "after"
                ],
                "description": "Legacy hike connector is already represented by route offsets and is excluded from transit simulation."
              },
              "reference_time": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Requested boarding time around which nearby sourced services are selected."
              },
              "timetable_options": {
                "type": "array",
                "description": "Actual services queried by the Skill for the exact trip date, including up to two departures before and after the reference time. Never generated by the page.",
                "items": {
                  "type": "object",
                  "required": [
                    "service_date",
                    "departure_time",
                    "arrival_time",
                    "source_id",
                    "checked_at",
                    "service_id"
                  ],
                  "properties": {
                    "service_date": {
                      "type": "string",
                      "format": "date"
                    },
                    "departure_time": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "arrival_time": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "source_id": {
                      "type": "string"
                    },
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "service_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "cable": {
          "type": "object"
        },
        "pass_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "title",
              "note",
              "source_id"
            ]
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "pending_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string"
    },
    "preview_timing": {
      "type": "object",
      "required": [
        "anchor_time",
        "anchor_label",
        "status",
        "notice"
      ],
      "properties": {
        "anchor_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "anchor_label": {
          "type": "string"
        },
        "status": {
          "const": "illustrative"
        },
        "notice": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "trip_type": {
      "type": "string",
      "const": "day_trip",
      "description": "Current release supports a one-day itinerary only"
    },
    "costs": {
      "type": "object",
      "required": [
        "currency",
        "items"
      ],
      "properties": {
        "currency": {
          "const": "JPY"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "amount_yen",
              "scope",
              "status",
              "included"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "amount_yen": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "enum": [
                  "per_person",
                  "group"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "estimated",
                  "confirmed"
                ]
              },
              "included": {
                "type": "boolean"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
